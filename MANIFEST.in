include LICENSE README.md CONTRIBUTING.md pyproject.toml
recursive-include pycmd *.py *.json
recursive-include tests *.py *.json *.md
recursive-include examples *.bat
recursive-include docs *.md
recursive-include tools *.py
prune tests/results
exclude tests/replay-*.json
global-exclude __pycache__ *.py[cod] .DS_Store
