    {
      "id": "redir_order_0",
      "rule": "IO-01",
      "question": "Handle duplication order, repeated redirects or open failure: >out.txt 2>&1",
      "mode": "batch",
      "script": {
        "text": "@echo off\n\"%PYTHON%\" probe.py streams >out.txt 2>&1\necho RC=%errorlevel%\n"
      }
    },
    {
      "id": "redir_order_1",
      "rule": "IO-01",
      "question": "Handle duplication order, repeated redirects or open failure: 2>&1 >out.txt",
      "mode": "batch",
      "script": {
        "text": "@echo off\n\"%PYTHON%\" probe.py streams 2>&1 >out.txt\necho RC=%errorlevel%\n"
      }
    },
    {
      "id": "redir_order_2",
      "rule": "IO-01",
      "question": "Handle duplication order, repeated redirects or open failure: 1>one.txt 1>two.txt",
      "mode": "batch",
      "script": {
        "text": "@echo off\n\"%PYTHON%\" probe.py streams 1>one.txt 1>two.txt\necho RC=%errorlevel%\n"
      }
    },
    {
      "id": "redir_order_3",
      "rule": "IO-01",
