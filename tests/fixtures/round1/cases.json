    {
      "id": "redir_restore",
      "rule": "IO-01",
      "question": "Does block redirection restore parent stdout?",
      "mode": "batch",
      "script": {
        "text": "@echo off\n(echo INSIDE)>out.txt\necho OUTSIDE\n"
      }
    },
    {
      "id": "batch_chain_call",
      "rule": "CALL-02",
      "question": "Direct batch transfer versus CALL return",
      "mode": "batch",
      "files": {
        "child.bat": {
          "text": "@echo off\necho CHILD\n"
        }
      },
      "script": {
        "text": "@echo off\necho BEFORE\ncall child.bat\necho AFTER\n"
      }
    },
    {
      "id": "batch_chain_direct",
      "rule": "CALL-02",
      "question": "Direct batch transfer versus CALL return",
      "mode": "batch",
      "files": {
        "child.bat": {
          "text": "@echo off\necho CHILD\n"
        }
      },
      "script": {
        "text": "@echo off\necho BEFORE\nchild.bat\necho AFTER\n"
      }
    },
    {
      "id": "args_shift",
      "rule": "ARG-01",
      "question": "SHIFT changes numbered parameters but what happens to %* and %0?",
      "mode": "batch",
      "args": " a \"b c\" d e f g h i j k",
      "script": {
        "text": "@echo off\necho ZERO=[%0] ONE=[%1] NINE=[%9] TEN=[%10] ALL=[%*]\nshift\necho ZERO=[%0] ONE=[%1] ALL=[%*]\nshift /2\necho ONE=[%1] TWO=[%2] ALL=[%*]\n"
      }
    },
    {
      "id": "args_separators",
      "rule": "ARG-01",
      "question": "Batch parameter delimiters versus external argv",
      "mode": "batch",
      "args": " a,b;c=d \"e f\"",
      "script": {
        "text": "@echo off\necho 1=[%1] 2=[%2] 3=[%3] 4=[%4] ALL=[%*]\n"
      }
    },
    {
      "id": "for_basic",
      "rule": "FOR-01",
      "question": "List delimiters, quoted values and case-sensitive loop variables",
      "mode": "batch",
      "script": {
        "text": "@echo off\nfor %%A in (one,two;three=four \"five six\") do echo A=[%%A] a=[%%a]\n"
      }
    },
    {
      "id": "for_nested",
      "rule": "FOR-01",
      "question": "Reuse of FOR variable and restoration",
      "mode": "batch",
      "script": {
        "text": "@echo off\nfor %%A in (outer) do (\necho BEFORE=[%%A]\nfor %%A in (inner) do echo INNER=[%%A]\necho AFTER=[%%A]\n)\n"
      }
    },
    {
