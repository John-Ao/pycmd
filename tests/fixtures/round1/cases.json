{
  "cases": [
    {
      "id": "exp_block",
      "rule": "EXP-01",
      "question": "Does percent freeze across a block while bang changes?",
      "mode": "batch",
      "script": {
        "text": "@echo off\nset X=old\n(\necho BEFORE=[%X%]/[!X!]\nset X=new\necho AFTER=[%X%]/[!X!]\n)\necho OUT=[%X%]/[!X!]\n"
      }
    },
    {
      "id": "exp_nested",
      "rule": "EXP-01",
      "question": "Do nested parentheses form separate percent-expansion boundaries?",
      "mode": "batch",
      "script": {
        "text": "@echo off\nset X=old\n(\nset X=new\n(echo NESTED=[%X%]/[!X!])\n)\n"
      }
    },
    {
      "id": "exp_endlocal_export",
      "rule": "ENV-01",
      "question": "Can percent-expanded local data survive ENDLOCAL on same line?",
      "mode": "batch",
      "script": {
        "text": "@echo off\nset X=outer\nsetlocal\nset X=inner\nendlocal&set Y=%X%\necho X=[%X%] Y=[%Y%]\n"
      }
    },
    {
